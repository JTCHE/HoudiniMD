{
  "name": "houdinimd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "tbuild": "next build && next start",
    "lint": "eslint",
    "preview": "bun scripts/write-build-stamp.ts && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cache:sync": "bun scripts/cache-sync.ts",
    "deploy": "export URL=$(bun scripts/site-url.ts) && bun scripts/check-env.ts && bun scripts/check-gates.ts && bun scripts/write-build-stamp.ts && opennextjs-cloudflare build && bun scripts/cache-sync.ts --apply && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "deploy:preview": "bun scripts/check-env.ts && bun scripts/write-build-stamp.ts && opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "usage": "bun scripts/usage.ts",
    "stamp": "bun scripts/write-build-stamp.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.7",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wrangler": "^4.117.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
