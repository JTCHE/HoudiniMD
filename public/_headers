# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# A browser that installed the old service worker must see this one, which
# removes it. A cached sw.js keeps the old one serving doc pages.
/sw.js
  Cache-Control: no-cache

# Named in every page's <head>, and changed only by a deploy.
/icon.svg
  Cache-Control: public,max-age=86400
/apple-touch-icon.png
  Cache-Control: public,max-age=86400
/manifest.webmanifest
  Cache-Control: public,max-age=86400
