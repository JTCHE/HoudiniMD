{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "houdinimd",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Off entirely. At head_sampling_rate 1 this billed 20.8M observability
  // events in one period, against 20M included. Re-enable with a sampling
  // rate below 1 if you need it, never at full rate.
  "observability": {
    "enabled": false,
  },
  // Rate limit for /api/generate, the one route that makes the Worker scrape
  // sidefx.com. This binding is the only limit on that route now: the Free
  // plan allows a single rule in the zone's http_ratelimit phase, and that one
  // guards /docs, where the request volume is. The route also refuses anything
  // that is not our own page or our own kickoff — see lib/generate-auth.ts.
  "ratelimits": [
    {
      "name": "GENERATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // Hard per-invocation CPU ceiling. Measured P50 is ~52ms and P99 ~1.16s, so
  // 200ms serves a normal page and kills a runaway one. This is the only hard
  // stop the platform offers: Cloudflare has no account spend cap, and budget
  // alerts only send mail.
  "limits": {
    "cpu_ms": 200,
  },
  "r2_buckets": [
    {
      "binding": "HOUDINIMD_ICONS",
      "bucket_name": "houdinimd-icons",
    },
    {
      // R2 bucket used for ISR/SSG page cache.
      // Create with: npx wrangler r2 bucket create houdinimd-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "houdinimd-cache",
    },
  ],
  // Page views + searches written by telemetry/*.ts, read by the
  // houdinimd-analytics TUI (D1 HTTP API, Read-scoped token). 90-day
  // retention enforced by the scheduled() cron below, not by D1 itself.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "houdinimd-analytics",
      "database_id": "6d9faa87-89b6-41fd-93b5-5031d1c5f892",
    },
  ],
  "triggers": {
    "crons": ["0 4 * * *"],
  },
  // Durable Object that runs ISR revalidation in the background (off the request
  // path). Configured via `queue: doQueue` in open-next.config.ts. SQLite-backed
  // (see the migration below), which is available on the Workers free plan.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  // Public origin for the Worker runtime. lib/site.ts throws without it, so
  // keeping it here (rather than in the dashboard) means it deploys atomically
  // with the code and cannot silently drift.
  "vars": {
    "URL": "https://houdinimd.com",
    // A doc page renders in ~31s of wall time at P99, and the revalidation
    // queue aborts its own fetch after 10s. The render still finishes and
    // still writes the entry to R2 — only the durable object's view of it
    // fails. It then retried 6 more times by default, and every attempt paid
    // for another render and another R2 Class A put: measured 5 writes per
    // page, 75k puts a day, against a 1M/month allowance. One retry is
    // enough. A page nobody asks for again does not need revalidating, and a
    // page somebody does ask for enqueues itself on the next stale read.
    "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "1",
  },
  "routes": [
    {
      "pattern": "houdinimd.com/*",
      "zone_name": "houdinimd.com",
    },
  ],
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "houdinimd",
    },
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
}
